# .env.example
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# --- Groq (LLM inference — FREE) ---
GROQ_API_KEY=gsk_...

# --- Embeddings ---
# HuggingFace sentence-transformers run LOCALLY — no API key needed!
# The model (~90 MB) downloads automatically on first run.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   ← default
# EMBEDDING_DEVICE=cpu                                      ← use 'cuda' if GPU

# --- Tavily Web Search (optional) ---
TAVILY_API_KEY=tvly-...

# --- LangSmith Observability (optional) ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=edumentor-os
